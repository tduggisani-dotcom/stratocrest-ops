# Copy to .env.local for local development. Never commit real values.
# Where each value comes from: docs/SETUP.md (Part E).

# Supabase project (local stack: run `pnpm db:start`, then `pnpm exec supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses Row Level Security. Never expose to the browser.
SUPABASE_SECRET_KEY=

# The app's public address (used in sign-in emails and redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# development | production  (seed:demo refuses to run in production)
APP_ENV=development

# The six teammates, as "Name <email>" separated by commas. Read by `pnpm seed`.
TEAM_EMAILS="John LaRocco <john@example.com>, Taeyoon Eom <taeyoon@example.com>, Brad Hall <brad@example.com>, Sam Browning <sam@example.com>, Ian Zalcberg <ian@example.com>, Tanush <tanush@example.com>"

# Optional: production project ref, so seed:demo can refuse to touch production.
PROD_SUPABASE_PROJECT_REF=
